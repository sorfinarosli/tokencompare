# Copy this file to ".streamlit/secrets.toml" (same folder) and add your real
# key. The real secrets.toml is git-ignored (see .gitignore), so your key will
# never be committed.
#
#     cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# Only the Gemini key is required — GPT-4o and Qwen 2.5 run 100% locally with
# no API key.

GEMINI_API_KEY = "your-gemini-api-key"
